# CONFIGURACIÓN LOCAL YA LISTA PARA WINDOWS / LOCALHOST
# Esta configuración evita que Django intente conectarse a PostgreSQL.
LOCALHOST_MODE=True
USE_POSTGRES=False
SECRET_KEY=dev-local-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# SQLite para que funcione directamente en localhost
DB_ENGINE=sqlite
POSTGRES_DB=tutor_conocimiento
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=tutor_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB es opcional. Si no está instalado, usa respaldo SQL automáticamente.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=tutor_semantico
MONGODB_COLLECTION=knowledge_chunks

# Tutor virtual con n8n + GroqCloud.
# 1) Cree una API key en GroqCloud.
# 2) Importe n8n/workflows/tutor_virtual_groq_workflow_cloud.json en n8n Cloud.
# 3) Publique/active el workflow y use el Webhook productivo.
AI_PROVIDER=n8n
N8N_WEBHOOK_URL=https://tutorvirtual.app.n8n.cloud/webhook/tutor-virtual-ai
N8N_SHARED_SECRET=dev-n8n-secret
N8N_TIMEOUT=60
N8N_FALLBACK_PROVIDER=groq

# GroqCloud: API gratuita/experimental con límites por cuenta y modelo.
GROQ_API_KEY=PEGUE_AQUI_SU_TOKEN_GROQ
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=60
GROQ_MAX_OUTPUT_TOKENS=1200
GROQ_TEMPERATURE=0.35

# Gemini opcional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=45
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_TEMPERATURE=0.35

# OpenAI opcional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
